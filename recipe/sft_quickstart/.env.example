# Copy to .env in the NorthRL repository root. Use shell KEY=value syntax.
WEAVER_BASE_URL=https://weaver-console.nex-agi.cn
WEAVER_API_KEY=replace-with-your-weaver-api-key
SFT_DATA_PATH=recipe/sft_quickstart/train.example.jsonl
SFT_MODEL=Qwen/Qwen3.5-0.8B:262144
SFT_TOKENIZER=Qwen/Qwen3.5-0.8B

# Optional: paths are relative to the repository root. No local GPU is required.
SFT_BATCH_SIZE=4
SFT_MAX_LENGTH=4096
SFT_EPOCHS=1
SFT_LR=1.0e-5
SFT_SHUFFLE=true
# The launcher uses .venv/bin/python if present, otherwise python from PATH.
# EXPERIMENT_PATH=logs/my-new-run
