# Copy to env.sh, fill in the values, then source env.sh before running.

# Weaver service for base-model sampling.
export WEAVER_BASE_URL=""
export WEAVER_API_KEY=""

# OpenAI-compatible judge for math rule-negative fallbacks and VerInstruct.
export LLM_JUDGE_URL=""
export LLM_JUDGE_MODEL=""
# Replace if the judge requires authentication.
export LLM_JUDGE_API_KEY="_"

# E2B is needed only for the sample with Python hard checks.
export E2B_API_KEY=""
# Leave empty for the service's default template, or set a name/ID with python3.
export E2B_TEMPLATE=""

# Optional overrides for a custom E2B service.
# export E2B_API_URL="https://api.example.com"
# export E2B_DOMAIN="example.com"
